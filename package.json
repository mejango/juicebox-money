{
  "name": "juicebox-money",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings=0 --no-cache",
    "ts:check": "next typegen && tsc --noEmit",
    "deps:check": "npm ls --all --omit=dev",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "env:check:build": "node scripts/check-deployment-env.mjs build",
    "env:check:all": "node scripts/check-deployment-env.mjs all",
    "container:check": "node scripts/check-container-definition.mjs",
    "protocol:check": "node scripts/check-protocol-deployments.mjs",
    "transaction:check": "node scripts/check-transaction-inventory.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "build:browser": "node scripts/build-browser.mjs",
    "test:browser": "node scripts/with-browser-env.mjs playwright test",
    "test:browser:install": "playwright install chromium",
    "test:browser:report": "playwright show-report",
    "budget": "node scripts/check-client-budgets.mjs",
    "check": "npm run deps:check && npm run audit:prod && npm run container:check && npm run lint && npm run ts:check && npm run protocol:check && npm run transaction:check && npm run test:ci && npm run build:browser && npm run budget && npm run test:browser",
    "check:deploy": "npm run check && npm run env:check:all"
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "1.4.0",
    "@getpara/react-sdk-lite": "3.8.0",
    "@getpara/wagmi-v2-connector": "3.8.0",
    "@getpara/web-sdk": "3.8.0",
    "@tanstack/react-query": "5.101.4",
    "multiformats": "14.0.4",
    "next": "16.2.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.55.8",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.28",
    "@types/react-test-renderer": "18.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.22",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    },
    "axios": "1.18.1",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.9.x"
  }
}
