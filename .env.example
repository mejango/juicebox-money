# Build-time public configuration. NEXT_PUBLIC values are embedded in the
# browser bundle; never put secrets here.
NEXT_PUBLIC_SITE_URL=https://juicebox.money
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENV=PROD
# Which Para on-ramp provider the headless "Get ETH" call bills through.
# Must be one live in the Para dashboard: STRIPE | MOONPAY | RAMP | CDP | MERCURYO.
NEXT_PUBLIC_PARA_ONRAMP_PROVIDER=STRIPE
# WalletConnect Cloud project id. Leave empty to hide the WalletConnect
# option entirely — the relay rejects unregistered ids, so a connector
# without one is a button that always fails.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_VERSION=local

# IPFS writes and RPC reads go directly from this trusted origin to Juicebox Center.
# Do not put a Juicebox Center API key in this client-side environment.
