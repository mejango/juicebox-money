# Build-time public configuration. NEXT_PUBLIC values are embedded in the
# browser bundle; never put secrets here.
NEXT_PUBLIC_SITE_URL=https://juicebox.money
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.xyz
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz
NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENV=PROD
# Dedicated browser-visible key. Restrict its daily/monthly quota in Dwellir.
NEXT_PUBLIC_DWELLIR_API_KEY=
NEXT_PUBLIC_VERSION=local

# Runtime-only server configuration. Pinning is fail-closed by default.
IPFS_PINNING_ENABLED=false

# Enabling public pin routes requires provider-scoped credentials and an
# external per-IP/account quota at the CDN/ingress. The ingress must strip any
# client-supplied x-juicebox-pinning-ingress-token header and inject the secret
# only after its policy passes; browser Origin headers are not authorization.
IPFS_PINNING_EDGE_PROTECTED=false
IPFS_PINNING_INGRESS_TOKEN=
# Filebase creates the canonical CID; Pinata redundantly pins the same CID.
FILEBASE_IPFS_RPC_TOKEN=
PINATA_JWT=
